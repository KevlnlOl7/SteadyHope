/algorithms/matlab/codegen/
/algorithms/matlab/slprj/
*.asv
*.autosave
*.slxc
*.mex*

# STM32CubeIDE local/generated state
/firmware/**/Debug/
/firmware/**/Release/
/firmware/**/.settings/
/.cubeide-workspaces/

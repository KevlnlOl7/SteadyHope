# macOS
.DS_Store

# Xcode
build/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Node/Python (Backend)
node_modules/
__pycache__/
.env

# Hardware
*.bak
*.tmp

# MATLAB / MATLAB Coder 建置產物 (可再生，不入庫)
